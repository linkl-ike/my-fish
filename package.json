{
  "name": "my-fish",
  "version": "1.3.9",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "assets",
    "fish",
    "README.md",
    "INSTALL.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "PUBLISH-GITHUB.md",
    "market",
    "tools",
    "PUBLISH-ALTERNATIVES.md",
    "PREREQUISITES.md",
    "changelog.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ]
    }
  },
  "description": "A virtual fish companion for DeepSeek Harness: persona, per-person long-term memory, QQ / Bilibili / Douyin chat, voice, diary and backups, plus a 17-tab control panel.",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "fish",
    "persona",
    "memory",
    "qq",
    "bilibili",
    "douyin",
    "companion",
    "chat"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/linkl-ike/my-fish"
  },
  "author": "my fish contributors",
  "homepage": "https://github.com/linkl-ike/my-fish#readme",
  "bugs": {
    "url": "https://github.com/linkl-ike/my-fish/issues"
  },
  "engines": {
    "dsh": ">=0.2.1",
    "node": ">=22.5.0"
  }
}
